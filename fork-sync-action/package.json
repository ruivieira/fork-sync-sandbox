{
  "name": "fork-sync-action",
  "version": "1.0.0",
  "description": "GitHub Action: sync a fork with its upstream (parent) repository by opening a pull request",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node test/local-sync.test.mjs"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
